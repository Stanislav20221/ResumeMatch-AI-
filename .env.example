# Only needed in live hh.ru mode. Use your real contact address as required by HH API.
# PowerShell: $env:HH_USER_AGENT = 'ResumeMatchAI/0.1 (your-real-email@example.com)'
HH_USER_AGENT=ResumeMatchAI/0.1 (your-real-email@example.com)
# Optional: enable local OCR for scanned PDFs (requires Tesseract with rus+eng data)
ENABLE_OCR=0
OCR_LANG=rus+eng
